# Copy to .env and fill in. NEVER commit .env.
VOISIT_API_KEY=vit_live_xxxxxxxxxxxxxxxx
PORT=3000
# Optional
# VOISIT_ASR_MODEL=voisit-asr-2026
# VOISIT_STORE=1        # 0 = ask VoisIT not to keep generated audio (we cache locally anyway)
# ALLOW_ANY_TEXT=0      # 1 = allow synthesising any text, not only lesson text (quota risk)
# TTS_CACHE_DIR=./cache/tts
